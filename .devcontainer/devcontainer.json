{
  "name": "flutter_learning - Flutter Web and .NET 10",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "forwardPorts": [
    5073,
    5173
  ],

  "portsAttributes": {
    "5073": {
      "label": ".NET Web API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Flutter Web",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  }
}